{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Task Manager",
  "version": "0.2.14",
  "identifier": "com.taskmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Task Manager",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'"],
        "style-src": ["'self'"],
        "style-src-attr": ["'unsafe-inline'"],
        "img-src": ["'self'", "data:", "asset:", "http://asset.localhost"],
        "font-src": ["'self'"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "https://github.com",
          "https://api.github.com",
          "https://release-assets.githubusercontent.com"
        ],
        "frame-src": ["'none'"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "form-action": ["'self'"],
        "frame-ancestors": ["'none'"]
      },
      "devCsp": {
        "default-src": ["'self'"],
        "script-src": ["'self'", "'nonce-taskmanager-dev'"],
        "style-src": ["'self'", "'nonce-taskmanager-dev'"],
        "style-src-attr": ["'unsafe-inline'"],
        "img-src": ["'self'", "data:", "asset:", "http://asset.localhost"],
        "font-src": ["'self'"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "https://github.com",
          "https://api.github.com",
          "https://release-assets.githubusercontent.com",
          "http://localhost:1420",
          "http://127.0.0.1:1420",
          "ws://localhost:1420",
          "ws://127.0.0.1:1420",
          "http://localhost:1421",
          "http://127.0.0.1:1421",
          "ws://localhost:1421",
          "ws://127.0.0.1:1421"
        ],
        "frame-src": ["'none'"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "form-action": ["'self'"],
        "frame-ancestors": ["'none'"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEREM5MzlBRDM0NTczNUIKUldSYmMwWFRtcFBjUFRLU0Yra0JkL0F3b1ZCRE53QlN1MmYwcDhwOUZwaHZ0VnBxQlBxN2lId24K",
      "endpoints": [
        "https://github.com/smileQiny/taskmanager/releases/latest/download/latest.json"
      ]
    }
  }
}
